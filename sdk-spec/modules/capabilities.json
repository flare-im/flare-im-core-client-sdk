{
  "key": "capabilities",
  "facade": "client.capabilities",
  "description": "Capability discovery and optional plugin dispatch through capability dispatch ops.",
  "methods": [
    {
      "name": "preparePluginCommand",
      "operation": "capability.prepare_plugin_command",
      "transport": "capability-dispatch-json",
      "cApi": "flare_capability_dispatch_json",
      "dispatchOp": "prepare_plugin_command",
      "request": "PluginCommandRequest",
      "response": "JsonObject",
      "stability": "experimental"
    },
    {
      "name": "pendingPluginCommand",
      "operation": "capability.pending_plugin_command",
      "transport": "capability-dispatch-json",
      "cApi": "flare_capability_dispatch_json",
      "dispatchOp": "pending_plugin_command",
      "request": "PluginCommandRequest",
      "response": "JsonObject",
      "stability": "experimental"
    },
    {
      "name": "reconcilePluginCommand",
      "operation": "capability.reconcile_plugin_command",
      "transport": "capability-dispatch-json",
      "cApi": "flare_capability_dispatch_json",
      "dispatchOp": "reconcile_plugin_command",
      "request": "PluginCommandRequest",
      "response": "JsonObject",
      "stability": "experimental"
    },
    {
      "name": "submitPluginCommand",
      "operation": "capability.submit_plugin_command",
      "transport": "capability-dispatch-json",
      "cApi": "flare_capability_dispatch_json",
      "dispatchOp": "submit_plugin_command",
      "request": "PluginCommandRequest",
      "response": "JsonObject",
      "stability": "experimental"
    },
    {
      "name": "acknowledgePluginCommand",
      "operation": "capability.acknowledge_plugin_command",
      "transport": "capability-dispatch-json",
      "cApi": "flare_capability_dispatch_json",
      "dispatchOp": "acknowledge_plugin_command",
      "request": "PluginCommandRequest",
      "response": "JsonObject",
      "stability": "experimental"
    },
    {
      "name": "invokePluginAction",
      "description": "With messageId, a successful operation result carrying data.messageState is validated and stored on that local message by version (older versions are ignored), then onMessagePluginStateChanged fires. Calls without messageId ignore messageState; storage failures never change the result.",
      "operation": "capability.plugin_ui_invoke",
      "transport": "capability-dispatch-json",
      "cApi": "flare_capability_dispatch_json",
      "dispatchOp": "plugin_ui_invoke",
      "request": "PluginUiEvaluationRequest",
      "response": "JsonObject",
      "stability": "experimental"
    },
    {
      "name": "presentPluginMessage",
      "description": "Returns the resolved plugin view (available, title, fields, actions) plus stateVersion (0 when the message has no stored state) and, only when available is true, data: the payload with the state stored on messageId overlaid at top level (null values remove keys).",
      "operation": "capability.plugin_ui_present",
      "transport": "capability-dispatch-json",
      "cApi": "flare_capability_dispatch_json",
      "dispatchOp": "plugin_ui_present",
      "request": "PluginUiEvaluationRequest",
      "response": "JsonObject",
      "stability": "experimental"
    },
    {
      "name": "pluginUiAction",
      "operation": "capability.plugin_ui_action",
      "transport": "capability-dispatch-json",
      "cApi": "flare_capability_dispatch_json",
      "dispatchOp": "plugin_ui_action",
      "request": "PluginUiEvaluationRequest",
      "response": "JsonObject",
      "stability": "experimental"
    },
    {
      "name": "resolvePluginMessage",
      "operation": "capability.plugin_ui_resolve",
      "transport": "capability-dispatch-json",
      "cApi": "flare_capability_dispatch_json",
      "dispatchOp": "plugin_ui_resolve",
      "request": "PluginUiEvaluationRequest",
      "response": "JsonObject",
      "stability": "experimental"
    },
    {
      "name": "pluginUiCatalog",
      "operation": "capability.plugin_ui_catalog",
      "transport": "capability-dispatch-json",
      "cApi": "flare_capability_dispatch_json",
      "dispatchOp": "plugin_ui_catalog",
      "request": "ListCapabilitiesRequest",
      "response": "JsonObject",
      "stability": "experimental"
    },
    {
      "name": "pluginComposerActions",
      "description": "payload {platform, locale}. Returns {actions: [{pluginId, contributionId, title, icon?, order}]}: the composer-action contributions of the authorized catalog for that platform, title in locale (exact tag, then language), sorted by order (default 1000) then title. icon is a design kit icon name and is absent when undeclared. Reads a fresh catalog every call; the server already trimmed it by grant, capability policy and user consent.",
      "operation": "capability.plugin_composer_actions",
      "transport": "capability-dispatch-json",
      "cApi": "flare_capability_dispatch_json",
      "dispatchOp": "plugin_composer_actions",
      "request": "PluginUiEvaluationRequest",
      "response": "JsonObject",
      "stability": "experimental"
    },
    {
      "name": "listCapabilities",
      "operation": "capability.list",
      "transport": "capability-dispatch-json",
      "cApi": "flare_capability_dispatch_json",
      "dispatchOp": "capability_list",
      "request": "ListCapabilitiesRequest",
      "response": "ListCapabilitiesResponse",
      "stability": "stable"
    },
    {
      "name": "listUserCapabilities",
