{
  "group": "events",
  "description": "Typed SDK event and notification models for cross-platform subscriptions.",
  "enums": [
    {
      "name": "SdkEventKind",
      "description": "Top-level event domain.",
      "values": [
        "lifecycle",
        "connection",
        "message",
        "notification",
        "conversation",
        "sync",
        "extension",
        "extension_event",
        "presence",
        "media",
        "capability",
        "view"
      ]
    },
    {
      "name": "LifecycleEventName",
      "description": "Client SDK lifecycle notification name.",
      "values": [
        "initializing",
        "initialized",
        "init_failed",
        "login_succeeded",
        "login_failed",
        "logged_out",
        "disposed"
      ]
    },
    {
      "name": "SdkConnectionState",
      "description": "Connection state exposed by event payloads.",
      "values": [
        "disconnected",
        "connecting",
        "connected",
        "ready",
        "reconnecting"
      ]
    },
    {
      "name": "ConnectionEventName",
      "description": "Connection event notification name.",
      "values": [
        "connecting",
        "connected",
        "ready",
        "disconnected",
        "reconnecting",
        "reconnect_failed",
        "state_changed",
        "sync_state_changed",
        "server_error",
        "kicked_off",
        "token_expired"
      ]
    },
    {
      "name": "MessageEventName",
      "description": "Message event notification name.",
      "values": [
        "received",
        "received_batch",
        "send_ack",
        "send_failed",
        "capability",
        "recalled",
        "typing",
        "typing_aggregate",
        "edited",
        "reaction_changed",
        "deleted",
        "read_receipt",
        "burn_scheduled",
        "burned",
        "hard_deleted",
        "pinned",
        "unpinned",
        "marked",
        "unmarked",
        "retention_scheduled",
        "retention_expired",
        "retention_purged",
        "presence_changed",
        "call_signal",
        "custom"
      ]
    },
    {
      "name": "ConversationEventName",
      "description": "Conversation event notification name.",
      "values": [
        "synced",
        "created",
        "updated",
        "unread_count_changed",
        "deleted"
      ]
    },
    {
      "name": "SyncEventName",
      "description": "Sync orchestration event notification name.",
      "values": [
        "state_changed",
        "started",
        "finished",
        "failed",
        "progress",
        "task_completed",
        "resync_needed",
        "readiness"
      ]
    },
    {
      "name": "ProgressEventName",
      "description": "Progress notification name.",
      "values": [
        "sync_progress",
        "upload_progress",
        "download_progress"
      ]
    },
    {
      "name": "CapabilityEventName",
      "description": "Capability and plugin event notification name.",
      "values": [
        "changed",
        "unavailable"
      ]
    }
  ],
  "models": [
    {
      "name": "SdkErrorPayload",
      "description": "Stable error payload used by lifecycle and async notification failures.",
      "fields": [
        {
          "name": "code",
          "wireName": "code",
          "type": "String",
          "required": true,
          "description": "Stable machine-readable error code."
        },
        {
          "name": "message",
          "wireName": "message",
          "type": "String",
          "required": true,
          "description": "Human-readable error message."
        },
        {
          "name": "operation",
          "wireName": "operation",
          "type": "String",
          "required": false,
          "description": "Operation that failed."
        },
        {
          "name": "retryable",
          "wireName": "retryable",
          "type": "Boolean",
          "required": false,
          "description": "Whether retrying may succeed."
        },
        {
          "name": "details",
          "wireName": "details",
          "type": "StringMap",
          "required": true,
          "description": "Opaque diagnostic details."
        }
      ]
    },
    {
      "name": "SdkEventEnvelope",
      "description": "Common event envelope emitted by every platform SDK event stream.",
      "fields": [
        {
          "name": "eventId",
          "wireName": "eventId",
          "type": "String",
          "required": true,
          "description": "Unique event id generated by the SDK adapter."
        },
        {
          "name": "kind",
          "wireName": "kind",
          "type": "SdkEventKind",
          "required": true,
          "description": "Top-level event domain."
        },
        {
          "name": "name",
          "wireName": "name",
          "type": "String",
          "required": true,
          "description": "Domain-specific event name."
        },
        {
          "name": "occurredAt",
          "wireName": "occurredAt",
          "type": "UInt64",
          "required": true,
          "description": "Event time in milliseconds."
        },
        {
          "name": "traceId",
          "wireName": "traceId",
          "type": "String",
          "required": false,
          "description": "Trace id for diagnostics when available."
        },
        {
          "name": "payload",
          "wireName": "payload",
          "type": "JsonObject",
          "required": true,
          "description": "Raw event payload for forward-compatible consumers."
        }
      ]
    },
    {
      "name": "LifecycleEvent",
      "description": "Lifecycle notification. Method return values remain the primary success/failure contract.",
      "fields": [
        {
          "name": "name",
          "wireName": "name",
          "type": "LifecycleEventName",
          "required": true,
          "description": "Lifecycle event name."
        },
        {
          "name": "operation",
          "wireName": "operation",
          "type": "String",
          "required": true,
          "description": "Operation associated with this lifecycle event."
        },
        {
          "name": "userId",
          "wireName": "userId",
          "type": "String",
          "required": false,
          "description": "Current user id when known."
        },
        {
          "name": "sessionId",
          "wireName": "sessionId",
          "type": "String",
          "required": false,
          "description": "SDK session id when available."
        },
        {
          "name": "error",
          "wireName": "error",
          "type": "SdkErrorPayload",
          "required": false,
          "description": "Failure details for *_failed events."
        }
      ]
    },
    {
      "name": "ConnectionEvent",
      "description": "Connection notification payload.",
      "fields": [
        {
          "name": "name",
          "wireName": "name",
          "type": "ConnectionEventName",
          "required": true,
          "description": "Connection event name."
        },
        {
          "name": "state",
          "wireName": "state",
          "type": "SdkConnectionState",
          "required": true,
          "description": "Connection state after this event."
        },
        {
          "name": "reason",
          "wireName": "reason",
          "type": "String",
          "required": false,
          "description": "Disconnect, kicked-off, or token-expired reason."
        },
        {
          "name": "attempt",
          "wireName": "attempt",
          "type": "UInt32",
          "required": false,
          "description": "Reconnect attempt number."
        },
        {
          "name": "error",
          "wireName": "error",
          "type": "SdkErrorPayload",
          "required": false,
          "description": "Server or reconnect failure details."
        }
      ]
    },
    {
      "name": "MessageReceivedEvent",
      "description": "Single message received notification.",
      "fields": [
        {
          "name": "message",
          "wireName": "message",
          "type": "Message",
          "required": true,
          "description": "Received message."
        }
      ]
    },
    {
      "name": "MessageReceivedBatchEvent",
      "description": "Batch message received notification.",
      "fields": [
        {
          "name": "messages",
          "wireName": "messages",
          "type": "MessageList",
          "required": true,
          "description": "Received messages."
        }
      ]
    },
    {
      "name": "MessageSendAckEvent",
      "description": "Message send acknowledgement notification.",
      "fields": [
        {
          "name": "ack",
          "wireName": "ack",
          "type": "SendMessageResponse",
          "required": true,
          "description": "Send acknowledgement."
        }
      ]
    },
    {
      "name": "MessageSendFailedEvent",
      "description": "Message send failure notification.",
      "fields": [
        {
          "name": "clientMsgId",
          "wireName": "clientMsgId",
          "type": "String",
          "required": true,
          "description": "Client message id that failed."
        },
        {
          "name": "reason",
          "wireName": "reason",
          "type": "String",
          "required": true,
          "description": "Failure reason."
        },
        {
          "name": "error",
          "wireName": "error",
          "type": "SdkErrorPayload",
          "required": false,
          "description": "Structured failure details when available."
        }
      ]
    },
    {
      "name": "MessageMutationEvent",
      "description": "Message mutation notification for recall, edit, delete, pin, mark and burn events.",
      "fields": [
        {
          "name": "name",
          "wireName": "name",
          "type": "MessageEventName",
          "required": true,
          "description": "Mutation event name."
        },
        {
          "name": "conversationId",
          "wireName": "conversationId",
          "type": "String",
          "required": true,
          "description": "Conversation id."
        },
        {
          "name": "messageId",
          "wireName": "messageId",
          "type": "String",
          "required": false,
          "description": "Client or server message id."
        },
        {
          "name": "serverMsgId",
          "wireName": "serverMsgId",
          "type": "String",
          "required": false,
          "description": "Server message id."
        },
        {
          "name": "userId",
          "wireName": "userId",
          "type": "String",
          "required": false,
          "description": "User associated with the mutation."
        },
        {
          "name": "reason",
          "wireName": "reason",
          "type": "String",
          "required": false,
          "description": "Mutation reason when available."
        }
      ]
    },
    {
      "name": "TypingEvent",
      "description": "Typing/input-state notification.",
      "fields": [
        {
          "name": "conversationId",
          "wireName": "conversationId",
          "type": "String",
          "required": true,
          "description": "Conversation id."
        },
        {
          "name": "userId",
          "wireName": "userId",
          "type": "String",
          "required": true,
          "description": "Typing user id."
        },
        {
          "name": "typing",
          "wireName": "typing",
          "type": "Boolean",
          "required": true,
          "description": "Whether user is typing."
        }
      ]
    },
    {
      "name": "TypingAggregateEvent",
      "description": "Aggregated typing/input-state notification for large conversations.",
      "fields": [
        {
          "name": "conversationId",
          "wireName": "conversationId",
          "type": "String",
          "required": true,
          "description": "Conversation id."
        },
        {
          "name": "typingUserIds",
          "wireName": "typingUserIds",
          "type": "StringList",
          "required": true,
          "description": "Users currently typing in the aggregation window."
        },
        {
          "name": "typingCount",
          "wireName": "typingCount",
          "type": "UInt32",
          "required": true,
          "description": "Number of users currently typing in the aggregation window."
        }
      ]
    },
    {
      "name": "ReadReceiptEvent",
      "description": "Read receipt notification.",
      "fields": [
        {
          "name": "conversationId",
          "wireName": "conversationId",
          "type": "String",
          "required": true,
          "description": "Conversation id."
        },
        {
          "name": "userId",
          "wireName": "userId",
          "type": "String",
          "required": true,
          "description": "Reader user id."
        },
        {
          "name": "readSeq",
          "wireName": "readSeq",
          "type": "UInt64",
          "required": true,
          "description": "Read sequence."
        }
      ]
    },
    {
      "name": "ReactionChangedEvent",
      "description": "Message reaction changed notification.",
      "fields": [
        {
          "name": "conversationId",
          "wireName": "conversationId",
          "type": "String",
          "required": true,
          "description": "Conversation id."
        },
        {
          "name": "serverMsgId",
          "wireName": "serverMsgId",
          "type": "String",
          "required": true,
          "description": "Server message id."
        },
        {
          "name": "userId",
          "wireName": "userId",
          "type": "String",
          "required": true,
          "description": "User who changed the reaction."
        },
        {
          "name": "emoji",
          "wireName": "emoji",
          "type": "String",
          "required": true,
          "description": "Reaction emoji."
        },
        {
          "name": "action",
          "wireName": "action",
          "type": "Int32",
          "required": true,
          "description": "Reaction action integer from core."
        }
      ]
    },
    {
      "name": "ConversationEvent",
      "description": "Conversation notification payload.",
      "fields": [
        {
          "name": "name",
          "wireName": "name",
          "type": "ConversationEventName",
          "required": true,
          "description": "Conversation event name."
        },
        {
          "name": "conversationId",
          "wireName": "conversationId",
          "type": "String",
          "required": false,
          "description": "Affected conversation id."
        },
        {
          "name": "conversationIds",
          "wireName": "conversationIds",
          "type": "StringList",
          "required": true,
          "description": "Affected conversation ids for sync events."
        },
        {
          "name": "unreadCount",
          "wireName": "unreadCount",
          "type": "UInt32",
          "required": false,
          "description": "Unread count for unread-count changes."
        }
      ]
    },
    {
      "name": "PresenceChangedEvent",
      "description": "Presence notification payload.",
      "fields": [
        {
          "name": "conversationId",
          "wireName": "conversationId",
          "type": "String",
          "required": false,
          "description": "Conversation id when presence is scoped to a conversation."
        },
        {
          "name": "userId",
          "wireName": "userId",
          "type": "String",
          "required": true,
          "description": "User id."
        },
        {
          "name": "status",
          "wireName": "status",
          "type": "String",
          "required": true,
          "description": "Presence status."
        },
        {
          "name": "extra",
          "wireName": "extra",
          "type": "StringMap",
          "required": true,
          "description": "Opaque presence details."
        }
      ]
    },
    {
      "name": "ProgressEvent",
      "description": "Generic sync, upload or download progress notification.",
      "fields": [
        {
          "name": "name",
          "wireName": "name",
          "type": "ProgressEventName",
          "required": true,
          "description": "Progress event name."
        },
        {
          "name": "operation",
          "wireName": "operation",
          "type": "String",
          "required": true,
          "description": "Operation being tracked."
        },
        {
          "name": "current",
          "wireName": "current",
          "type": "UInt64",
          "required": true,
          "description": "Current progress units."
        },
        {
          "name": "total",
          "wireName": "total",
          "type": "UInt64",
          "required": true,
          "description": "Total progress units."
        },
        {
          "name": "taskId",
          "wireName": "taskId",
          "type": "String",
          "required": false,
          "description": "Task identifier when available."
        },
        {
          "name": "detail",
          "wireName": "detail",
          "type": "String",
          "required": false,
          "description": "Human-readable progress detail."
        }
      ]
    },
    {
      "name": "SyncEvent",
      "description": "Sync orchestration notification payload.",
      "fields": [
        {
          "name": "name",
          "wireName": "name",
          "type": "SyncEventName",
          "required": true,
          "description": "Sync event name."
        },
        {
          "name": "runId",
          "wireName": "runId",
          "type": "String",
          "required": false,
          "description": "Stable sync run id used to correlate readiness, progress, and completion."
        },
        {
          "name": "trigger",
          "wireName": "trigger",
          "type": "String",
          "required": false,
          "description": "Sync trigger."
        },
        {
          "name": "scope",
          "wireName": "scope",
          "type": "String",
          "required": false,
          "description": "Sync scope."
        },
        {
          "name": "visibility",
          "wireName": "visibility",
          "type": "String",
          "required": false,
          "description": "Sync visibility policy."
        },
        {
          "name": "reason",
          "wireName": "reason",
          "type": "String",
          "required": false,
          "description": "Sync reason for diagnostics and startup wait reports."
        },
        {
          "name": "phase",
          "wireName": "phase",
          "type": "String",
          "required": false,
          "description": "Sync phase."
        },
        {
          "name": "task",
          "wireName": "task",
          "type": "String",
          "required": false,
          "description": "Sync task name."
        },
        {
          "name": "stage",
          "wireName": "stage",
          "type": "String",
          "required": false,
          "description": "Readiness stage for sync.readiness events."
        },
        {
          "name": "progress",
          "wireName": "progress",
          "type": "UInt32",
          "required": false,
          "description": "Progress percentage from 0 to 100."
        },
        {
          "name": "error",
          "wireName": "error",
          "type": "SdkErrorPayload",
          "required": false,
          "description": "Failure details for failed sync events."
        }
      ]
    },
    {
      "name": "CapabilityEvent",
      "description": "Capability/plugin notification payload.",
      "fields": [
        {
          "name": "name",
          "wireName": "name",
          "type": "CapabilityEventName",
          "required": true,
          "description": "Capability event name."
        },
        {
          "name": "capability",
          "wireName": "capability",
          "type": "String",
          "required": false,
          "description": "Capability key."
        },
        {
          "name": "reason",
          "wireName": "reason",
          "type": "String",
          "required": false,
          "description": "Unavailable/change reason."
        }
      ]
    }
  ]
}
