{
  "schemaVersion": 1,
  "description": "Name projection vectors: every candidate name of a person or a conversation in, the DisplayName the core projects out. A value that is empty or equal to the id of what it names is not a name; nothing is judged by shape. core-sdk src/domain/display_name.rs reads every case; business SDKs that list people or conversations call the same core functions and read these cases too.",
  "idTail": [
    { "name": "long id keeps the last four characters", "id": "u_1234569876", "expected": "9876" },
    { "name": "surrounding whitespace is trimmed first", "id": "  u_9876  ", "expected": "9876" },
    { "name": "an id of four characters is kept whole", "id": "9876", "expected": "9876" },
    { "name": "an id of three characters is kept whole", "id": "u42", "expected": "u42" },
    { "name": "an empty id has an empty tail", "id": "", "expected": "" },
    { "name": "characters, not bytes, are counted", "id": "用户甲乙丙丁", "expected": "甲乙丙丁" }
  ],
  "people": [
    {
      "name": "only an alias",
      "userId": "u_9876",
      "conversationType": null,
      "alias": "Boss",
      "memberNickname": "",
      "profileName": "",
      "snapshot": "",
      "expected": { "kind": "named", "text": "Boss", "source": "alias" }
    },
