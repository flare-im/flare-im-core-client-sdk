{
  "name": "flare-im-core-client-sdk",
  "apiVersion": "1.0.0",
  "ffiContractVersion": "flare-im-ffi/v1",
  "sourceOfTruth": "../flare-im-core-sdk",
  "ffiEntry": "../flare-im-core-sdk/bindings/c",
  "principles": [
    "flare-im-core-sdk owns IM behavior",
    "bindings/c is the only native boundary",
    "client SDK packages are typed platform adapters",
    "stable semantics use typed fields, not metadata",
    "platform APIs keep canonical method names"
  ],
  "include": {
    "platforms": "platforms/targets.json",
    "errors": "shared/errors.json",
    "states": "shared/states.json",
    "events": "shared/events.json",
    "listeners": "shared/listeners.json",
    "native": "native/c_abi.json",
    "models": [
      "models/session.json",
      "models/connection.json",
      "models/diagnostics.json",
      "models/conversations.json",
      "models/views.json",
      "models/sync.json",
      "models/messages.json",
      "models/message_content_elems.json",
      "models/message_builder.json",
      "models/events.json"
    ],
    "modules": [
      "modules/session.json",
      "modules/connection.json",
      "modules/conversations.json",
      "modules/message_builder.json",
      "modules/messages.json",
      "modules/sync.json",
      "modules/user.json",
      "modules/presence.json",
      "modules/media.json",
      "modules/capabilities.json",
      "modules/views.json",
      "modules/events.json",
      "modules/diagnostics.json"
    ]
  }
}
