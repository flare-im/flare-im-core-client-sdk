{
  "name": "flare-core-uni-app",
  "private": true,
  "version": "0.1.0",
  "description": "Production-oriented IM app template for @flare-im/sdk (uni-app).",
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:sfc": "node ../../scripts/check-sfc.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run check:sfc && npm run test"
  },
  "dependencies": {
    "@flare-im/sdk": "file:../../packages/flare-core-typescript-sdk",
    "@flare-im/vue-ui": "^1.0.9",
    "markdown-it": "^14.2.0",
    "naive-ui": "^2.44.1",
    "protobufjs": "^8.5.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vue/compiler-sfc": "^3.5.13",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
