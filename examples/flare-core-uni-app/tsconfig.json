{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "baseUrl": ".",
      // @flare-im/vue-ui 的 paths 映射**故意删掉了**：它写死同级仓路径，
      // 而 kit 在另一个仓，单独 clone 的 main 里不存在。moduleResolution=bundler
      // 会尊重包的 exports 映射，所以两种模式统一走 node_modules——
      // dev 下 file: 依赖是指向同级仓的符号链接，解析到同一批文件。
    "paths": {
      "@vicons/ionicons5": ["../../../flare-im-design/vue-im-ui/node_modules/@vicons/ionicons5"],
      "@flare-im/sdk": ["../../packages/flare-core-typescript-sdk/src/index.ts"],
      "@flare-im/sdk/web": ["../../packages/flare-core-typescript-sdk/src/adapters/web/index.ts"],
      "@flare-im/sdk/uni-app": ["../../packages/flare-core-typescript-sdk/src/adapters/uni-app/index.ts"],
      "@flare-im/sdk/*": ["../../packages/flare-core-typescript-sdk/src/*"],
      "markdown-it": ["../../../flare-im-design/vue-im-ui/node_modules/@types/markdown-it/index.d.ts"],
      "naive-ui": ["../../../flare-im-design/vue-im-ui/node_modules/naive-ui"],
      "vue": ["../../../flare-im-design/vue-im-ui/node_modules/vue"],
      "vue-router": ["../../../flare-im-design/vue-im-ui/node_modules/vue-router"],
      "@application/*": ["src/application/*"],
      "@domain/*": ["src/domain/*"],
      "@infrastructure/*": ["src/infrastructure/*"],
      "@interface/*": ["src/interface/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "App.vue",
    "pages/**/*.vue",
    "../flare-core-web-app/src/**/*.ts",
    "../flare-core-web-app/src/**/*.vue"
  ],
  "exclude": ["../flare-core-web-app/src/shared/testing/**/*.ts"]
}
