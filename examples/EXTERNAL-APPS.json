{
  "$comment": "Reference apps that live in their own repositories. They are excluded from this repository by .gitignore (not submodules); bootstrap-external-apps.sh clones them into examples/<dir>. Keep this list in sync with .gitignore and the table in README.md.",
  "apps": [
    {
      "dir": "flare-core-web-app",
      "repo": "https://github.com/flare-im/flare-core-web-demo.git",
      "platform": "Web (Vue 3, WASM)",
      "sdk": "packages/flare-core-typescript-sdk (web target)"
    },
    {
      "dir": "flare-core-tauri-app",
      "repo": "https://github.com/flare-im/flare-core-tauri-demo.git",
      "platform": "Tauri 2 (Vue 3)",
      "sdk": "packages/flare-core-typescript-sdk (tauri target)"
    },
    {
      "dir": "flare-core-flutter-app",
      "repo": "https://github.com/flare-im/flare-core-flutter-demo.git",
      "platform": "Flutter",
      "sdk": "packages/flare-core-flutter-sdk"
    },
    {
      "dir": "flare-core-ios-app",
      "repo": "https://github.com/flare-im/flare-core-ios-demo.git",
      "platform": "iOS (SwiftUI)",
      "sdk": "packages/flare-core-apple-sdk"
    },
    {
      "dir": "flare-core-android-app",
      "repo": "https://github.com/flare-im/flare-core-android-demo.git",
      "platform": "Android (Jetpack Compose)",
      "sdk": "packages/flare-core-android-sdk"
    }
  ]
}
