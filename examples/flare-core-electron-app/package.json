{
  "name": "flare-core-electron-app",
  "private": true,
  "version": "0.1.0",
  "description": "Production-oriented IM app template for @flare-im/sdk (Electron).",
  "author": "Flare IM",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run dev:electron",
    "dev:web": "vite --host 0.0.0.0 --port 1433 --strictPort",
    "dev:electron": "concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:web\" \"npm:electron:serve\"",
    "electron:serve": "npm run build:electron-main && wait-on tcp:1433 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:1433 electron .",
    "build": "npm run build:web && npm run build:electron-main",
    "build:web": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:electron-main": "tsc -p tsconfig.electron.json",
    "preview:web": "vite preview --host 0.0.0.0 --port 1433",
    "start:electron": "npm run build && electron .",
    "package": "npm run package:dir",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "verify:architecture": "node ../../packages/flare-core-typescript-sdk/scripts/verify-no-client-shadow-views.mjs",
    "test": "node ../../packages/flare-core-typescript-sdk/scripts/verify-no-client-shadow-views.mjs && vitest run && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "@flare-im/sdk": "file:../../packages/flare-core-typescript-sdk",
    "@flare-im/vue-ui": "file:../../../flare-im-design/vue-im-ui",
    "markdown-it": "^14.2.0",
    "naive-ui": "^2.44.1",
    "protobufjs": "^8.5.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "optionalDependencies": {
    "wa-sqlite": "^1.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.6",
    "wait-on": "^9.0.10",
    "vue-tsc": "^2.1.10"
  },
  "build": {
    "appId": "im.flare.core.electron",
    "productName": "Flare Core",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "assets/icons/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/icons/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "assets/icons/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Network",
      "icon": "assets/icons/icon.png",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    }
  }
}
