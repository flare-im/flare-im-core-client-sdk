{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@application/*": ["src/application/*"],
      "@domain/*": ["src/domain/*"],
      "@infrastructure/*": ["src/infrastructure/*"],
      "@ui/*": ["src/*"],
      "@shared/*": ["src/shared/*"],
      "@business/*": ["src/business/*"],
      "@flare-im/sdk": ["../../packages/flare-core-typescript-sdk/src/index.ts"],
      "@flare-im/sdk/*": ["../../packages/flare-core-typescript-sdk/src/*"],
      "@flare-im/sdk/react-native": [
        "../../packages/flare-core-typescript-sdk/src/adapters/react-native/index.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
